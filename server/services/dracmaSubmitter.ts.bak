/**
 * Dracma Submitter Service
 * Serviço para submissão automática de recibos no sistema Dracma via Puppeteer (RPA)
 */

import puppeteer, { Browser } from 'puppeteer';
import { logger } from '../utils/logger';
import { sql } from '../neonConfig';
import axios from 'axios';
import * as fs from 'fs';
import * as path from 'path';

interface ReceiptData {
  id: number;
  userId: number; // Adicionado para buscar credenciais do pastor
  merchantName: string | null;
  receiptDate: string | null; // yyyy-mm-dd format
  totalAmount: string | null;
  category: string | null;
  imageUrl: string;
  taxId: string | null;
}

interface DracmaCredentials {
  username: string;
  password: string;
}

export class DracmaSubmitter {
  private browser: Browser | null = null;

  /**
   * Inicializa o browser Puppeteer
   */
  async init(): Promise<void> {
    this.browser = await puppeteer.launch({
      headless: true, // Mudar para false durante debug
      args: [
        '--no-sandbox',
        '--disable-setuid-sandbox',
        '--disable-dev-shm-usage',
        '--disable-gpu',
        '--disable-software-rasterizer',
        '--disable-extensions',
      ],
      defaultViewport: {
        width: 1920,
        height: 1080,
      },
    });
    logger.info('🌐 Puppeteer browser inicializado');
  }

  /**
   * Fecha o browser
   */
  async close(): Promise<void> {
    if (this.browser) {
      await this.browser.close();
      this.browser = null;
      logger.info('🌐 Puppeteer browser fechado');
    }
  }

  /**
   * Busca credenciais do Dracma no banco de dados para um usuário específico
   * Se o usuário não tiver configurações, busca do pastor da igreja dele
   */
  async getCredentials(userId: number): Promise<DracmaCredentials> {
    // Primeiro, buscar informações do usuário
    const userResult = await sql<{ id: number; role: string; church_id: number | null }[]>`
      SELECT id, role, church_id FROM users WHERE id = ${userId} LIMIT 1
    `;

    if (!userResult.length) {
      throw new Error(`Usuário ${userId} não encontrado`);
    }

    const user = userResult[0];
    const churchId = user.church_id;

    // Tentar buscar credenciais do próprio usuário primeiro (se for pastor)
    let configs = await sql<{ key: string; value: string }[]>`
      SELECT key, value FROM automation_config
      WHERE key IN ('dracma_username', 'dracma_password')
      AND user_id = ${userId}
      AND value != 'CHANGE_ME'
    `;

    // Se não encontrou e tem igreja associada, buscar do pastor da igreja
    if (configs.length < 2 && churchId) {
      const pastorResult = await sql<{ id: number }[]>`
        SELECT id FROM users
        WHERE church_id = ${churchId}
        AND role IN ('pastor', 'admin')
        LIMIT 1
      `;

      if (pastorResult.length > 0) {
        const pastorId = pastorResult[0].id;
        configs = await sql<{ key: string; value: string }[]>`
          SELECT key, value FROM automation_config
          WHERE key IN ('dracma_username', 'dracma_password')
          AND user_id = ${pastorId}
          AND value != 'CHANGE_ME'
        `;
      }
    }

    // Fallback para configurações globais (exemplos)
    if (configs.length < 2) {
      configs = await sql<{ key: string; value: string }[]>`
        SELECT key, value FROM automation_config
        WHERE key IN ('dracma_username', 'dracma_password')
        AND user_id IS NULL
      `;
    }

    const creds: Record<string, string> = {};
    configs.forEach(c => {
      creds[c.key.replace('dracma_', '')] = c.value;
    });

    if (!creds.username || !creds.password || creds.username === 'CHANGE_ME' || creds.password === 'CHANGE_ME') {
      throw new Error('Credenciais do Dracma não configuradas para este usuário/igreja');
    }

    return creds as DracmaCredentials;
  }

  /**
   * Submete um recibo no Dracma via Puppeteer
   */
  async submitReceipt(receipt: ReceiptData): Promise<void> {
    if (!this.browser) {
      await this.init();
    }

    const page = await this.browser!.newPage();

    try {
      logger.info(`🚀 Submetendo recibo ${receipt.id} (usuário ${receipt.userId}) no Dracma...`);

      const credentials = await this.getCredentials(receipt.userId);

      // Step 1: Navegar para o Dracma e fazer login
      await page.goto('https://dracma.sdasystems.org/', {
        waitUntil: 'networkidle2',
        timeout: 30000,
      });

      logger.info('📄 Página do Dracma carregada');

      // IMPORTANTE: Os seletores abaixo são PLACEHOLDERS
      // Você precisa inspecionar a página real do Dracma e atualizar os seletores
      // Veja /docs/dracma-selectors.md para instruções

      // Aguardar campo de login aparecer
      try {
        await page.waitForSelector('input[name="username"], input[name="email"], input#username', {
          timeout: 10000,
        });
      } catch {
        // Fallback: salvar screenshot se não encontrar campo de login
        const screenshot = `/tmp/dracma_no_login_${Date.now()}.png`;
        await page.screenshot({ path: screenshot, fullPage: true });
        logger.error(`❌ Campo de login não encontrado. Screenshot: ${screenshot}`);
        throw new Error('Campo de login não encontrado no Dracma');
      }

      // Fazer login
      await page.type(
        'input[name="username"], input[name="email"], input#username',
        credentials.username
      );
      await page.type('input[name="password"], input#password', credentials.password);

      await Promise.all([
        page.click('button[type="submit"], button.btn-login, input[type="submit"]'),
        page.waitForNavigation({ waitUntil: 'networkidle2', timeout: 20000 }),
      ]);

      logger.info(`✅ Login realizado como ${credentials.username}`);

      // Step 2: Navegar para página de nova despesa
      // AJUSTAR URL conforme necessário
      await page.goto('https://dracma.sdasystems.org/expenses/new', {
        waitUntil: 'networkidle2',
        timeout: 20000,
      });

      logger.info('📝 Página de nova despesa carregada');

      // Step 3: Preencher formulário
      // IMPORTANTE: Ajustar seletores conforme HTML real do Dracma

      if (receipt.merchantName) {
        await page.waitForSelector(
          'input#merchant_name, input[name="merchant"], input[name="estabelecimento"]',
          {
            timeout: 5000,
          }
        );
        await page.type(
          'input#merchant_name, input[name="merchant"], input[name="estabelecimento"]',
          receipt.merchantName
        );
        logger.info(`📌 Merchant name: ${receipt.merchantName}`);
      }

      if (receipt.receiptDate) {
        // Converter yyyy-mm-dd para dd/mm/yyyy se necessário
        const [year, month, day] = receipt.receiptDate.split('-');
        const formattedDate = `${day}/${month}/${year}`;

        await page.waitForSelector('input#expense_date, input[name="date"], input[type="date"]', {
          timeout: 5000,
        });

        // Limpar campo antes de digitar
        await page.click('input#expense_date, input[name="date"], input[type="date"]', {
          clickCount: 3,
        });

        await page.type(
          'input#expense_date, input[name="date"], input[type="date"]',
          formattedDate
        );
        logger.info(`📅 Data: ${formattedDate}`);
      }

      if (receipt.totalAmount) {
        // Limpar valor: "123,45" -> "123.45"
        const cleanAmount = receipt.totalAmount.replace(',', '.');

        await page.waitForSelector('input#amount, input[name="amount"], input[name="valor"]', {
          timeout: 5000,
        });
        await page.type('input#amount, input[name="amount"], input[name="valor"]', cleanAmount);
        logger.info(`💰 Valor: R$ ${cleanAmount}`);
      }

      if (receipt.category) {
        // Selecionar categoria no dropdown (se existir)
        try {
          await page.waitForSelector(
            'select#category, select[name="category"], select[name="categoria"]',
            {
              timeout: 3000,
            }
          );
          await page.select(
            'select#category, select[name="category"], select[name="categoria"]',
            receipt.category
          );
          logger.info(`🏷️ Categoria: ${receipt.category}`);
        } catch {
          logger.warn(`⚠️ Campo de categoria não encontrado ou não é dropdown`);
        }
      }

      // Step 4: Upload da imagem da nota fiscal
      const fileInputSelector = 'input[type="file"]';

      try {
        await page.waitForSelector(fileInputSelector, { timeout: 5000 });

        // Download image to temp location
        const imagePath = await this.downloadImage(receipt.imageUrl, receipt.id);

        const fileInput = await page.$(fileInputSelector);
        if (fileInput) {
          await fileInput.uploadFile(imagePath);
          logger.info(`📎 Imagem carregada: ${imagePath}`);

          // Aguardar upload ser processado
          await page.waitForTimeout(2000);
        }
      } catch {
        logger.warn(`⚠️ Campo de upload de arquivo não encontrado. Continuando sem imagem...`);
      }

      // Step 5: Submeter formulário
      await Promise.all([
        page.click('button[type="submit"], button.btn-submit, input[type="submit"]'),
        page.waitForNavigation({ waitUntil: 'networkidle2', timeout: 30000 }).catch(() => {
          // Ignora timeout se a página não navegar
          logger.warn('⚠️ Timeout ao aguardar navegação após submit. Verificando confirmação...');
        }),
      ]);

      logger.info('📨 Formulário submetido');

      // Step 6: Extrair ID de confirmação
      let confirmationId = null;

      try {
        // Aguardar elemento de confirmação aparecer
        await page.waitForSelector('.confirmation-number, .success-message, .alert-success', {
          timeout: 5000,
        });

        confirmationId = await page
          .$eval('.confirmation-number, .confirmation-id', el => el.textContent?.trim())
          .catch(() => null);

        if (!confirmationId) {
          // Fallback: buscar por mensagem de sucesso
          const successMsg = await page
            .$eval('.success-message, .alert-success', el => el.textContent?.trim())
            .catch(() => null);

          if (successMsg) {
            confirmationId = `SUCCESS_${Date.now()}`;
          }
        }
      } catch {
        logger.warn('⚠️ Não foi possível encontrar ID de confirmação na página');
      }

      if (!confirmationId) {
        // Tirar screenshot para debug
        const screenshot = `/tmp/dracma_no_confirmation_${receipt.id}_${Date.now()}.png`;
        await page.screenshot({ path: screenshot, fullPage: true });
        logger.warn(`⚠️ Screenshot salvo: ${screenshot}`);

        // Mesmo assim marcar como sucesso provisório
        confirmationId = `PENDING_${receipt.id}_${Date.now()}`;
      }

      // Atualizar banco: sucesso
      await sql`
        UPDATE expense_receipts
        SET
          status = 'submitted',
          dracma_submitted_at = NOW(),
          dracma_confirmation_id = ${confirmationId},
          updated_at = NOW()
        WHERE id = ${receipt.id}
      `;

      logger.info(`✅ Recibo ${receipt.id} submetido com sucesso! Confirmação: ${confirmationId}`);

      // Limpar arquivo temporário se existir
      const _tempPath = path.join('/tmp', `receipt_${receipt.id}_*.jpg`);
      const files = fs.readdirSync('/tmp').filter(f => f.startsWith(`receipt_${receipt.id}_`));
      files.forEach(f => fs.unlinkSync(path.join('/tmp', f)));
    } catch (error) {
      logger.error(`❌ Erro ao submeter recibo ${receipt.id}:`, error);

      // Screenshot para debugging
      const screenshotPath = `/tmp/dracma_error_${receipt.id}_${Date.now()}.png`;
      await page.screenshot({ path: screenshotPath, fullPage: true });
      logger.error(`📸 Screenshot de erro salvo: ${screenshotPath}`);

      // Atualizar banco: erro
      await sql`
        UPDATE expense_receipts
        SET
          status = 'error',
          dracma_error = ${(error as Error).message},
          dracma_retry_count = dracma_retry_count + 1,
          updated_at = NOW()
        WHERE id = ${receipt.id}
      `;

      throw error;
    } finally {
      await page.close();
    }
  }

  /**
   * Download de imagem para arquivo temporário
   */
  private async downloadImage(url: string, receiptId: number): Promise<string> {
    try {
      const response = await axios.get(url, {
        responseType: 'arraybuffer',
        timeout: 15000,
        headers: {
          'User-Agent': 'Mozilla/5.0 (compatible; 7Care Receipt Bot/1.0)',
        },
      });

      const buffer = Buffer.from(response.data);
      const tempPath = path.join('/tmp', `receipt_${receiptId}_${Date.now()}.jpg`);

      fs.writeFileSync(tempPath, buffer);
      logger.info(`📥 Imagem baixada: ${tempPath} (${buffer.length} bytes)`);

      return tempPath;
    } catch (error) {
      logger.error(`❌ Erro ao baixar imagem de ${url}:`, error);
      throw new Error(`Falha ao baixar imagem: ${(error as Error).message}`);
    }
  }
}
