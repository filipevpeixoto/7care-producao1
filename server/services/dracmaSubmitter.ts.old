/**
 * Dracma Submitter Service
 * Serviço para submissão automática de recibos no sistema Dracma via Puppeteer (RPA)
 */

import puppeteer, { Browser } from 'puppeteer';
import { logger } from '../utils/logger';
import { sql } from '../neonConfig';
import axios from 'axios';
import * as fs from 'fs';
import * as path from 'path';

interface ReceiptData {
  id: number;
  userId: number; // ID do pastor (para buscar credenciais)
  districtId: number; // ID do distrito (isolamento multi-pastor)
  merchantName: string | null;
  receiptDate: string | null; // yyyy-mm-dd format ou dd/mm/yyyy
  totalAmount: string | null;
  category: string | null;
  imageUrl: string;
  taxId: string | null;
  documentNumber?: string | null; // Número da nota fiscal
  accessKey?: string | null; // Chave de acesso SEFAZ (44 dígitos)
  purpose?: string | null; // Finalidade da despesa
}

interface DracmaCredentials {
  username: string;
  password: string;
}

export class DracmaSubmitter {
  private browser: Browser | null = null;

  /**
   * Inicializa o browser Puppeteer
   */
  async init(): Promise<void> {
    this.browser = await puppeteer.launch({
      headless: true, // Mudar para false durante debug
      args: [
        '--no-sandbox',
        '--disable-setuid-sandbox',
        '--disable-dev-shm-usage',
        '--disable-gpu',
        '--disable-software-rasterizer',
        '--disable-extensions',
      ],
      defaultViewport: {
        width: 1920,
        height: 1080,
      },
    });
    logger.info('🌐 Puppeteer browser inicializado');
  }

  /**
   * Fecha o browser
   */
  async close(): Promise<void> {
    if (this.browser) {
      await this.browser.close();
      this.browser = null;
      logger.info('🌐 Puppeteer browser fechado');
    }
  }

  /**
   * Busca credenciais do Dracma no banco de dados para um pastor específico
   * IMPORTANTE: Apenas pastores podem enviar notas fiscais
   */
  async getCredentials(userId: number): Promise<DracmaCredentials> {
    // Verificar que o usuário é um pastor
    const userResult = await sql<{ id: number; role: string; name: string }[]>`
      SELECT id, role, name FROM users WHERE id = ${userId} LIMIT 1
    `;

    if (!userResult.length) {
      throw new Error(`Usuário ${userId} não encontrado`);
    }

    const user = userResult[0];

    if (!['pastor', 'admin', 'superadmin'].includes(user.role)) {
      throw new Error(
        `Usuário ${user.name} não é pastor. Apenas pastores podem enviar notas fiscais.`
      );
    }

    // Buscar credenciais do próprio pastor
    const configs = await sql<{ key: string; value: string }[]>`
      SELECT key, value FROM automation_config
      WHERE key IN ('dracma_username', 'dracma_password')
      AND user_id = ${userId}
      AND value != 'CHANGE_ME'
    `;

    const creds: Record<string, string> = {};
    configs.forEach(c => {
      creds[c.key.replace('dracma_', '')] = c.value;
    });

    if (!creds.username || !creds.password) {
      throw new Error(
        `Pastor ${user.name} não tem credenciais configuradas. ` +
          `Execute: npx tsx configure-pastor-credentials.mjs`
      );
    }

    return creds as DracmaCredentials;
  }

  /**
   * Submete um recibo no Dracma via Puppeteer
   */
  async submitReceipt(receipt: ReceiptData): Promise<void> {
    if (!this.browser) {
      await this.init();
    }

    const page = await this.browser!.newPage();

    try {
      logger.info(`🚀 Submetendo recibo ${receipt.id} (usuário ${receipt.userId}) no Dracma...`);

      const credentials = await this.getCredentials(receipt.userId);

      // Step 1: Navegar para o Dracma e fazer login
      await page.goto('https://dracma.sdasystems.org/', {
        waitUntil: 'networkidle2',
        timeout: 30000,
      });

      logger.info('📄 Página do Dracma carregada');

      // IMPORTANTE: Os seletores abaixo são PLACEHOLDERS
      // Você precisa inspecionar a página real do Dracma e atualizar os seletores
      // Veja /docs/dracma-selectors.md para instruções

      // Aguardar campo de login aparecer
      try {
        await page.waitForSelector('input[name="username"], input[name="email"], input#username', {
          timeout: 10000,
        });
      } catch {
        // Fallback: salvar screenshot se não encontrar campo de login
        const screenshot = `/tmp/dracma_no_login_${Date.now()}.png`;
        await page.screenshot({ path: screenshot, fullPage: true });
        logger.error(`❌ Campo de login não encontrado. Screenshot: ${screenshot}`);
        throw new Error('Campo de login não encontrado no Dracma');
      }

      // Fazer login
      await page.type(
        'input[name="username"], input[name="email"], input#username',
        credentials.username
      );
      await page.type('input[name="password"], input#password', credentials.password);

      await Promise.all([
        page.click('button[type="submit"], button.btn-login, input[type="submit"]'),
        page.waitForNavigation({ waitUntil: 'networkidle2', timeout: 20000 }),
      ]);

      logger.info(`✅ Login realizado como ${credentials.username}`);

      // Step 2: Navegar para página de nova despesa (URL REAL extraída)
      await page.goto('https://dracma.sdasystems.org/accounts-payable/create', {
        waitUntil: 'networkidle2',
        timeout: 20000,
      });

      logger.info('📝 Página de nova despesa carregada');

      // Aguardar dropdowns Semantic UI carregarem
      await page.waitForSelector('.ui.dropdown', { timeout: 10000 });
      await page.waitForTimeout(1000); // Aguardar JS do Semantic UI inicializar

      // Step 3: Preencher formulário com seletores REAIS do Dracma
      // Baseado em extração realizada em 01/02/2026

      // 3.1. Dropdown "Tipo de Documento" (padrão: NFCe)
      await this.selectSemanticDropdown(page, 'Tipo de Documento', 'NFCe');

      // 3.2. Dropdown "Emitente" (nome do estabelecimento)
      if (receipt.merchantName) {
        try {
          await this.selectSemanticDropdown(page, 'Emitente', receipt.merchantName);
        } catch {
          // Se não encontrar, pode ser que precise buscar/criar novo emitente
          logger.warn(`⚠️ Emitente "${receipt.merchantName}" não encontrado no dropdown`);
        }
      }

      // 3.3. Campo "Data de Emissão" (flatpickr)
      if (receipt.receiptDate) {
        // Formato esperado: dd/mm/yyyy (ex: "22/01/2026")
        const dateValue = this.formatDateToBrazilian(receipt.receiptDate);
        await this.fillInputByLabel(page, 'Data de Emissão', dateValue);
        logger.info(`📅 Data de Emissão: ${dateValue}`);
      }

      // 3.4. Campo "Número" da nota fiscal
      if (receipt.taxId || receipt.merchantName) {
        // Extrair número da nota fiscal (pode vir do OCR)
        const numeroNota = this.extractDocumentNumber(receipt);
        if (numeroNota) {
          await this.fillInputByLabel(page, 'Número', numeroNota);
          logger.info(`🔢 Número: ${numeroNota}`);
        }
      }

      // 3.5. Campo "Valor" (formato R$ 270,44)
      if (receipt.totalAmount) {
        // Manter formato brasileiro: R$ 270,44
        const valorFormatado = this.formatCurrencyToBrazilian(receipt.totalAmount);
        await this.fillInputByLabel(page, 'Valor', valorFormatado);
        logger.info(`💰 Valor: ${valorFormatado}`);
      }

      // 3.6. Campo "Chave de Acesso" (se disponível do OCR)
      const chaveAcesso = this.extractAccessKey(receipt);
      if (chaveAcesso) {
        await this.fillInputByLabel(page, 'Chave de Acesso', chaveAcesso);
        logger.info(`🔑 Chave de Acesso: ${chaveAcesso.substring(0, 10)}...`);
      }

      // 3.7. Textarea "Finalidade"
      const finalidade = receipt.category
        ? `Despesa categoria: ${receipt.category} - ${receipt.merchantName || ''}`
        : `Despesa: ${receipt.merchantName || 'Não especificado'}`;

      await this.fillTextareaByLabel(page, 'Finalidade', finalidade);
      logger.info(`📝 Finalidade: ${finalidade}`);

      // Step 4: Upload da imagem da nota fiscal
      const fileInputSelector = 'input[type="file"]';

      try {
        await page.waitForSelector(fileInputSelector, { timeout: 5000 });

        // Download image to temp location
        const imagePath = await this.downloadImage(receipt.imageUrl, receipt.id);

        const fileInput = await page.$(fileInputSelector);
        if (fileInput) {
          await fileInput.uploadFile(imagePath);
          logger.info(`📎 Imagem carregada: ${imagePath}`);

          // Aguardar upload ser processado
          await page.waitForTimeout(2000);
        }
      } catch {
        logger.warn(`⚠️ Campo de upload de arquivo não encontrado. Continuando sem imagem...`);
      }

      // Step 5: Submeter formulário
      await Promise.all([
        page.click('button[type="submit"], button.btn-submit, input[type="submit"]'),
        page.waitForNavigation({ waitUntil: 'networkidle2', timeout: 30000 }).catch(() => {
          // Ignora timeout se a página não navegar
          logger.warn('⚠️ Timeout ao aguardar navegação após submit. Verificando confirmação...');
        }),
      ]);

      logger.info('📨 Formulário submetido');

      // Step 6: Extrair ID de confirmação
      let confirmationId = null;

      try {
        // Aguardar elemento de confirmação aparecer
        await page.waitForSelector('.confirmation-number, .success-message, .alert-success', {
          timeout: 5000,
        });

        confirmationId = await page
          .$eval('.confirmation-number, .confirmation-id', el => el.textContent?.trim())
          .catch(() => null);

        if (!confirmationId) {
          // Fallback: buscar por mensagem de sucesso
          const successMsg = await page
            .$eval('.success-message, .alert-success', el => el.textContent?.trim())
            .catch(() => null);

          if (successMsg) {
            confirmationId = `SUCCESS_${Date.now()}`;
          }
        }
      } catch {
        logger.warn('⚠️ Não foi possível encontrar ID de confirmação na página');
      }

      if (!confirmationId) {
        // Tirar screenshot para debug
        const screenshot = `/tmp/dracma_no_confirmation_${receipt.id}_${Date.now()}.png`;
        await page.screenshot({ path: screenshot, fullPage: true });
        logger.warn(`⚠️ Screenshot salvo: ${screenshot}`);

        // Mesmo assim marcar como sucesso provisório
        confirmationId = `PENDING_${receipt.id}_${Date.now()}`;
      }

      // Atualizar banco: sucesso
      await sql`
        UPDATE expense_receipts
        SET
          status = 'submitted',
          dracma_submitted_at = NOW(),
          dracma_confirmation_id = ${confirmationId},
          updated_at = NOW()
        WHERE id = ${receipt.id}
      `;

      logger.info(`✅ Recibo ${receipt.id} submetido com sucesso! Confirmação: ${confirmationId}`);

      // Limpar arquivo temporário se existir
      const _tempPath = path.join('/tmp', `receipt_${receipt.id}_*.jpg`);
      const files = fs.readdirSync('/tmp').filter(f => f.startsWith(`receipt_${receipt.id}_`));
      files.forEach(f => fs.unlinkSync(path.join('/tmp', f)));
    } catch (error) {
      logger.error(`❌ Erro ao submeter recibo ${receipt.id}:`, error);

      // Screenshot para debugging
      const screenshotPath = `/tmp/dracma_error_${receipt.id}_${Date.now()}.png`;
      await page.screenshot({ path: screenshotPath, fullPage: true });
      logger.error(`📸 Screenshot de erro salvo: ${screenshotPath}`);

      // Atualizar banco: erro
      await sql`
        UPDATE expense_receipts
        SET
          status = 'error',
          dracma_error = ${(error as Error).message},
          dracma_retry_count = dracma_retry_count + 1,
          updated_at = NOW()
        WHERE id = ${receipt.id}
      `;

      throw error;
    } finally {
      await page.close();
    }
  }

  /**
   * Seleciona opção em dropdown do Semantic UI
   * Baseado na estrutura: .ui.dropdown > .menu > .item[data-value]
   */
  private async selectSemanticDropdown(
    page: any,
    labelText: string,
    valueToSelect: string
  ): Promise<void> {
    logger.info(`🔽 Selecionando dropdown "${labelText}" = "${valueToSelect}"`);

    // Encontrar todos os campos (.field) e procurar pelo label
    const fields = await page.$$('.field');

    for (const field of fields) {
      const label = await field.$eval('label', (el: any) => el?.textContent?.trim()).catch(() => null);

      if (label && label.includes(labelText)) {
        // Encontrou o campo correto, agora clicar no dropdown
        const dropdown = await field.$('.ui.dropdown');

        if (!dropdown) {
          throw new Error(`Dropdown "${labelText}" não encontrado`);
        }

        // Clicar para abrir
        await dropdown.click();
        await page.waitForTimeout(500);

        // Procurar item no menu
        const menu = await dropdown.$('.menu');
        if (!menu) {
          throw new Error(`Menu do dropdown "${labelText}" não encontrado`);
        }

        const items = await menu.$$('.item');

        for (const item of items) {
          const itemText = await item.evaluate((el: any) => el.textContent?.trim());

          if (itemText && itemText.includes(valueToSelect)) {
            await item.click();
            await page.waitForTimeout(300);
            logger.info(`✅ Selecionado: "${itemText}"`);
            return;
          }
        }

        throw new Error(`Opção "${valueToSelect}" não encontrada no dropdown "${labelText}"`);
      }
    }

    throw new Error(`Campo com label "${labelText}" não encontrado`);
  }

  /**
   * Preenche input de texto buscando pelo label
   */
  private async fillInputByLabel(page: any, labelText: string, value: string): Promise<void> {
    logger.info(`✍️ Preenchendo "${labelText}" = "${value}"`);

    const fields = await page.$$('.field');

    for (const field of fields) {
      const label = await field.$eval('label', (el: any) => el?.textContent?.trim()).catch(() => null);

      if (label && label.includes(labelText)) {
        // Encontrar input dentro do field
        const input = await field.$('input[type="text"], input.flatpickr-input, input[type="number"]');

        if (!input) {
          throw new Error(`Input "${labelText}" não encontrado`);
        }

        // Limpar campo (selecionar tudo e deletar)
        await input.click({ clickCount: 3 });
        await page.keyboard.press('Backspace');

        // Digitar valor
        await input.type(value, { delay: 50 });
        logger.info(`✅ Campo preenchido`);
        return;
      }
    }

    throw new Error(`Campo com label "${labelText}" não encontrado`);
  }

  /**
   * Preenche textarea buscando pelo label
   */
  private async fillTextareaByLabel(page: any, labelText: string, value: string): Promise<void> {
    logger.info(`✍️ Preenchendo textarea "${labelText}"`);

    const fields = await page.$$('.field');

    for (const field of fields) {
      const label = await field.$eval('label', (el: any) => el?.textContent?.trim()).catch(() => null);

      if (label && label.includes(labelText)) {
        const textarea = await field.$('textarea');

        if (!textarea) {
          throw new Error(`Textarea "${labelText}" não encontrado`);
        }

        await textarea.click();
        await textarea.type(value, { delay: 30 });
        logger.info(`✅ Textarea preenchido`);
        return;
      }
    }

    throw new Error(`Textarea com label "${labelText}" não encontrado`);
  }

  /**
   * Converte data para formato brasileiro dd/mm/yyyy
   * Aceita: yyyy-mm-dd, dd/mm/yyyy, ou ISO string
   */
  private formatDateToBrazilian(dateString: string | null): string {
    if (!dateString) return '';

    // Se já está no formato brasileiro, retornar
    if (/^\d{2}\/\d{2}\/\d{4}$/.test(dateString)) {
      return dateString;
    }

    // Se está no formato ISO (yyyy-mm-dd)
    if (/^\d{4}-\d{2}-\d{2}/.test(dateString)) {
      const [year, month, day] = dateString.split('-');
      return `${day}/${month}/${year}`;
    }

    // Fallback: tentar parsear como Date
    try {
      const date = new Date(dateString);
      const day = String(date.getDate()).padStart(2, '0');
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const year = date.getFullYear();
      return `${day}/${month}/${year}`;
    } catch {
      return dateString; // Retornar original se falhar
    }
  }

  /**
   * Formata valor monetário para formato brasileiro
   * Entrada: "270.44", "270,44", "R$ 270,44"
   * Saída: "R$ 270,44"
   */
  private formatCurrencyToBrazilian(amount: string | null): string {
    if (!amount) return 'R$ 0,00';

    // Remover "R$" e espaços
    let clean = amount.replace(/R\$\s*/g, '').trim();

    // Converter ponto para vírgula
    clean = clean.replace('.', ',');

    // Garantir que tem centavos
    if (!clean.includes(',')) {
      clean += ',00';
    }

    return `R$ ${clean}`;
  }

  /**
   * Extrai número do documento fiscal (se disponível)
   */
  private extractDocumentNumber(receipt: ReceiptData): string | null {
    // Pode vir do OCR ou ser gerado
    // Por enquanto retornar null, implementar OCR depois
    return null;
  }

  /**
   * Extrai chave de acesso SEFAZ (44 dígitos) do OCR
   */
  private extractAccessKey(receipt: ReceiptData): string | null {
    // Implementar extração de chave de acesso do OCR
    // Por enquanto retornar null
    return null;
  }

  /**
   * Download de imagem para arquivo temporário
   */
  private async downloadImage(url: string, receiptId: number): Promise<string> {
    try {
      const response = await axios.get(url, {
        responseType: 'arraybuffer',
        timeout: 15000,
        headers: {
          'User-Agent': 'Mozilla/5.0 (compatible; 7Care Receipt Bot/1.0)',
        },
      });

      const buffer = Buffer.from(response.data);
      const tempPath = path.join('/tmp', `receipt_${receiptId}_${Date.now()}.jpg`);

      fs.writeFileSync(tempPath, buffer);
      logger.info(`📥 Imagem baixada: ${tempPath} (${buffer.length} bytes)`);

      return tempPath;
    } catch (error) {
      logger.error(`❌ Erro ao baixar imagem de ${url}:`, error);
      throw new Error(`Falha ao baixar imagem: ${(error as Error).message}`);
    }
  }
}
