{
  "include": ["client/src/**/*", "shared/**/*", "server/**/*"],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**",
    "e2e/**/*",
    "tests/**/*",
    "playwright.config.ts",
    "**/*.stories.tsx",
    "server/migrate*.ts"
  ],
  "compilerOptions": {
    "target": "ES2020",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    // Variáveis não usadas - habilitado para detectar código morto
    // Vite/esbuild ignora estas flags no build, mas IDE e pre-commit as reportam
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    // exactOptionalPropertyTypes desativado temporariamente pois requer refatoração extensiva
    // "exactOptionalPropertyTypes": true,
    // noUncheckedIndexedAccess requer refatoração extensiva do código existente
    // Habilitar gradualmente quando não houver acesso indexado sem verificação de undefined
    "noUncheckedIndexedAccess": false,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
