# ============================================
# VARIÁVEIS OBRIGATÓRIAS
# ============================================

# PostgreSQL do Neon (copie do Netlify)
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/database?sslmode=require

# Chave secreta JWT (copie do Netlify)
JWT_SECRET=sua-chave-secreta-minimo-32-caracteres


# ============================================
# VARIÁVEIS OPCIONAIS
# ============================================

# Web Push Notifications (copie do Netlify se tiver)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# URL da aplicação (atualize após deploy)
APP_URL=https://seu-projeto.vercel.app

# Google Apps Script (se usar integração com Google Drive/Calendar)
GOOGLE_SCRIPT_URL=

# Token de setup (se tiver no Netlify)
SETUP_TOKEN=

# Senha padrão do admin (se tiver configurado, senão usa 'meu7care')
DEFAULT_ADMIN_PASSWORD=

# Email Brevo/SendinBlue (se usar envio de emails)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# CORS origens permitidas (deixe vazio para usar defaults)
ALLOWED_ORIGINS=


# ============================================
# VARIÁVEIS AUTOMÁTICAS (NÃO PRECISA ADICIONAR)
# ============================================
# NODE_ENV=production (Vercel define automaticamente)
