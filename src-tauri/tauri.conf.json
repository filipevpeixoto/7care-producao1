{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "7Care",
  "version": "1.0.0",
  "identifier": "app.7care.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:tauri",
    "devUrl": "http://localhost:3065",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "7Care",
        "width": 1200,
        "height": 800,
        "minWidth": 375,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://7careadv.netlify.app https://*.netlify.app; img-src 'self' asset: http://asset.localhost https://7careadv.netlify.app data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  },
  "plugins": {}
}
