{
  "name": "church-plus-manager",
  "version": "1.0.0",
  "description": "Sistema de gerenciamento para igrejas - Neon Database + Netlify",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "dev:tauri": "tauri dev",
    "build": "npx vite build",
    "build:tauri": "VITE_API_URL=https://7care.vercel.app vite build --config vite.config.ts",
    "tauri": "tauri",
    "tauri:build": "VITE_API_URL=https://7care.vercel.app tauri build",
    "build:server": "esbuild server/index.prod.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist-server/index.cjs",
    "start:server": "NODE_ENV=production node dist-server/index.js",
    "build:full": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "NODE_OPTIONS='--max-old-space-size=4096' tsc",
    "deploy": "npm run build && npx netlify deploy --prod --message \"$(git log -1 --pretty=%B)\"",
    "deploy:preview": "npm run build && npx netlify deploy",
    "deploy:status": "bash scripts/deploy-status.sh",
    "migrate-to-neon": "NODE_ENV=development tsx -e \"import('./server/migrateToNeon.js').then(m => m.migrateToNeon())\"",
    "migrate-google-calendar": "NODE_ENV=development tsx server/migrations/addGoogleCalendarIntegration.ts",
    "migrate-google-calendar:prod": "NODE_ENV=production tsx server/migrations/addGoogleCalendarIntegration.ts",
    "setup-google-calendar": "bash scripts/setup-google-calendar.sh",
    "deploy-google-calendar": "bash scripts/deploy-google-calendar.sh",
    "open:prod": "open https://7care.vercel.app/",
    "lint": "eslint server/ client/src/ shared/ --max-warnings 0",
    "lint:fix": "eslint server/ client/src/ shared/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --reporter=verbose",
    "test:client": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:client:coverage": "vitest run --coverage",
    "test:server": "vitest run --config vitest.config.server.ts --reporter=verbose",
    "test:server:coverage": "vitest run --config vitest.config.server.ts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:client && npm run test:server && npm run test:e2e",
    "prepare": "husky",
    "audit:check": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "audit:report": "npm audit --json > security-audit.json && echo '✅ Audit report saved to security-audit.json'",
    "security:scan": "npm run audit:check && echo '✅ No moderate/high/critical vulnerabilities found'",
    "clean": "rm -rf node_modules dist dist-server coverage .vite",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean:cache": "rm -rf node_modules/.cache .vite",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:rebuild": "docker-compose up -d --build",
    "db:migrate": "npm run migrate-to-neon",
    "db:seed": "tsx server/setupNeonData.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:web\"",
    "validate": "npm run typecheck && npm run lint && npm run test:all"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@netlify/edge-functions-bootstrap": "^2.17.1",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
