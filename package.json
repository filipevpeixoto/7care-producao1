    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "vite-plugin-pwa": "^1.2.0",
    "web-push": "^3.6.7",
    "web-vitals": "^5.1.0",
    "workbox-window": "^7.4.0",
    "ws": "^8.18.0",
