    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "immer": "^11.1.3",
    "input-otp": "^1.4.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
